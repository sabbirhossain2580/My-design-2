rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'sabbir1610734190@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidUserCreate(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        (!('email' in request.auth.token) || data.email == request.auth.token.email) &&
        data.role is string &&
        data.role.size() >= 4 &&
        data.role.size() <= 16 &&
        (data.role == 'user' || (data.role == 'admin' && isBootstrappedAdmin())) &&
        data.createdAt == request.time;
    }

    function isValidUserUpdate(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == existing().uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 254 &&
        data.email == existing().email &&
        data.role is string &&
        data.role.size() >= 4 &&
        data.role.size() <= 16 &&
        data.role in ['user', 'admin'] &&
        data.createdAt == existing().createdAt;
    }

    function isValidUploadCreate(data, docId) {
      return data.keys().hasAll(['id', 'uploaderUid', 'uploaderEmail', 'fileName', 'fileUrl', 'description', 'createdAt']) &&
        data.keys().hasOnly(['id', 'uploaderUid', 'uploaderEmail', 'fileName', 'fileUrl', 'storagePath', 'description', 'createdAt']) &&
        data.id is string &&
        data.id.size() >= 1 &&
        data.id.size() <= 128 &&
        data.id == docId &&
        data.uploaderUid is string &&
        data.uploaderUid.size() >= 1 &&
        data.uploaderUid.size() <= 128 &&
        data.uploaderUid == request.auth.uid &&
        data.uploaderEmail is string &&
        data.uploaderEmail.size() >= 3 &&
        data.uploaderEmail.size() <= 254 &&
        (!('email' in request.auth.token) || data.uploaderEmail == request.auth.token.email) &&
        data.fileName is string &&
        data.fileName.size() >= 1 &&
        data.fileName.size() <= 255 &&
        data.fileUrl is string &&
        data.fileUrl.size() <= 2048 &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512)) &&
        data.description is string &&
        data.description.size() <= 2000 &&
        data.createdAt == request.time;
    }

    function isValidUploadUpdate(data) {
      return data.keys().hasAll(['id', 'uploaderUid', 'uploaderEmail', 'fileName', 'fileUrl', 'description', 'createdAt']) &&
        data.keys().hasOnly(['id', 'uploaderUid', 'uploaderEmail', 'fileName', 'fileUrl', 'storagePath', 'description', 'createdAt']) &&
        data.id is string &&
        data.id.size() >= 1 &&
        data.id.size() <= 128 &&
        data.id == existing().id &&
        data.uploaderUid is string &&
        data.uploaderUid.size() >= 1 &&
        data.uploaderUid.size() <= 128 &&
        data.uploaderUid == existing().uploaderUid &&
        data.uploaderEmail is string &&
        data.uploaderEmail.size() >= 3 &&
        data.uploaderEmail.size() <= 254 &&
        data.uploaderEmail == existing().uploaderEmail &&
        data.fileName is string &&
        data.fileName.size() >= 1 &&
        data.fileName.size() <= 255 &&
        data.fileUrl is string &&
        data.fileUrl.size() <= 2048 &&
        (!('storagePath' in data) || (data.storagePath is string && data.storagePath.size() <= 512)) &&
        data.description is string &&
        data.description.size() <= 2000 &&
        data.createdAt == existing().createdAt;
    }

    // Users collection: users can read their own record, admin reads all; no self-promotion on create/update
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserCreate(incoming(), userId);
      allow update: if isSignedIn() && isValidId(userId) && isValidUserUpdate(incoming()) && isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role']);
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Uploads collection: any logged-in user can CREATE their own upload; ONLY admin can READ/LIST/UPDATE/DELETE
    match /uploads/{docId} {
      allow create: if isSignedIn() && isValidId(docId) && isValidUploadCreate(incoming(), docId);
      allow get, delete: if isValidId(docId) && isAdmin();
      allow list: if isAdmin();
      allow update: if isSignedIn() && isValidId(docId) && isValidUploadUpdate(incoming()) && isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['fileName', 'description']);
    }
  }
}
