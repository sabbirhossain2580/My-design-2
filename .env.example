# ==============================================================================
# Renaissance Group HR Portal — Environment Configuration (.env.example)
# IMPORTANT: Never commit actual secret keys or credentials to public Git repositories!
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV="production"

# Cloud SQL for PostgreSQL Connection (Runtime App User)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="app_db"
SQL_USER="app_user"
SQL_PASSWORD=""

# Cloud SQL Admin Credentials (Schema Management via Drizzle Kit)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# Session & Cryptographic Token Security
AUTH_SECRET="rg-hr-secure-entropy-key-2026-renaissance-portal"
AUTH_SALT="rg-hr-pbkdf2-salt-2026-production"

# Optional Cloud & External Application Integration
APP_URL="https://ais-pre-eczu67rzzpk2esvq42hfvw-850937953254.asia-southeast1.run.app"
GEMINI_API_KEY=""
